{
  "name": "freshfits-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "karma start karma.conf.cjs --single-run",
    "test:watch": "karma start karma.conf.cjs",
    "test:coverage": "cross-env COVERAGE=1 karma start karma.conf.cjs --single-run",
    "test:node": "jasmine --config=jasmine.json",
    "test:node:coverage": "node scripts/limpiar-cobertura.cjs && cross-env BABEL_ENV=coverage jasmine --config=jasmine.json && nyc report --temp-dir=.nyc_output --reporter=text --reporter=text-summary --reporter=html --report-dir=coverage-node"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-react": "^7.24.7",
    "@babel/register": "^7.24.6",
    "@testing-library/react": "^14.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "babel-loader": "^9.1.3",
    "babel-plugin-istanbul": "^6.1.1",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "jasmine": "^5.3.0",
    "jasmine-core": "^5.3.0",
    "jsdom": "^25.0.1",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-sourcemap-loader": "^0.4.0",
    "karma-spec-reporter": "^0.0.36",
    "karma-webpack": "^5.0.1",
    "nyc": "^17.1.0",
    "style-loader": "^4.0.0",
    "vite": "^5.4.0",
    "webpack": "^5.95.0"
  }
}
